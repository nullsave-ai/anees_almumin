import android.app.WallpaperManager
import android.appwidget.AppWidgetManager
import android.content.ComponentName
import android.content.ContentValues
import android.content.Intent
import android.graphics.BitmapFactory
import android.net.Uri
import android.os.Build
import android.os.Environment
import android.provider.MediaStore
import android.webkit.MimeTypeMap
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File

// جسور أصلية صغيرة (تعمل في خيوط خلفية ولا تحجب الواجهة):
// 1) anees/adhan: إضافة صوت أذان مخصص إلى MediaStore
// 2) anees/wallpaper: تعيين خلفية ثابتة، فتح الخلفية الحية، تثبيت الويدجت، تحديثه
class MainActivity : FlutterActivity() {
    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        val messenger = flutterEngine.dartExecutor.binaryMessenger

        MethodChannel(messenger, "anees/adhan").setMethodCallHandler { call, result ->
            when (call.method) {
                "import" -> {
                    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
                        result.error("unsupported", null, null)
                        return@setMethodCallHandler
                    }
                    val path = call.argument<String>("path")!!
                    val name = call.argument<String>("name")!!
                    Thread {
                        try {
                            val uri = importSound(path, name)
                            runOnUiThread { result.success(uri) }
                        } catch (e: Exception) {
                            runOnUiThread { result.error("failed", e.message, null) }
                        }
                    }.start()
                }
                "delete" -> {
                    try {
                        contentResolver.delete(Uri.parse(call.argument<String>("uri")!!), null, null)
                        result.success(true)
                    } catch (e: Exception) {
                        result.success(false)
                    }
                }
                else -> result.notImplemented()
            }
        }

        MethodChannel(messenger, "anees/wallpaper").setMethodCallHandler { call, result ->
            when (call.method) {
                "setStatic" -> {
                    val path = call.argument<String>("path")!!
                    val which = call.argument<Int>("which") ?: 3
                    Thread {
                        try {
                            val bmp = BitmapFactory.decodeFile(path)
                            val wm = WallpaperManager.getInstance(this)
                            if (Build.VERSION.SDK_INT >= 24) wm.setBitmap(bmp, null, true, which) else wm.setBitmap(bmp)
                            bmp.recycle()
                            runOnUiThread { result.success(true) }
                        } catch (e: Exception) {
                            runOnUiThread { result.error("failed", e.message, null) }
                        }
                    }.start()
                }
                "setLive" -> {
                    try {
                        val i = Intent(WallpaperManager.ACTION_CHANGE_LIVE_WALLPAPER)
                            .putExtra(
                                WallpaperManager.EXTRA_LIVE_WALLPAPER_COMPONENT,
                                ComponentName(this, AneesLiveWallpaperService::class.java)
                            )
                        startActivity(i)
                        result.success(true)
                    } catch (e: Exception) {
                        try {
                            startActivity(Intent(WallpaperManager.ACTION_LIVE_WALLPAPER_CHOOSER))
                            result.success(true)
                        } catch (e2: Exception) {
                            result.error("failed", e2.message, null)
                        }
                    }
                }
                "pinWidget" -> {
                    val awm = AppWidgetManager.getInstance(this)
                    if (Build.VERSION.SDK_INT >= 26 && awm.isRequestPinAppWidgetSupported) {
                        awm.requestPinAppWidget(ComponentName(this, AneesPrayerWidget::class.java), null, null)
                        result.success(true)
                    } else {
                        result.success(false)
                    }
                }
                "refreshWidget" -> {
                    AneesPrayerWidget.updateAll(this)
                    result.success(true)
                }
                else -> result.notImplemented()
            }
        }
    }

    private fun importSound(path: String, name: String): String {
        val ext = name.substringAfterLast('.', "mp3").lowercase()
        val mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext) ?: "audio/mpeg"
        val values = ContentValues().apply {
            put(MediaStore.MediaColumns.DISPLAY_NAME, name)
            put(MediaStore.MediaColumns.MIME_TYPE, mime)
            put(MediaStore.Audio.Media.IS_NOTIFICATION, 1)
            put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_NOTIFICATIONS + "/AneesAlMumin")
            put(MediaStore.MediaColumns.IS_PENDING, 1)
        }
        val collection = MediaStore.Audio.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
        val uri = contentResolver.insert(collection, values) ?: throw IllegalStateException("insert failed")
        contentResolver.openOutputStream(uri)!!.use { out ->
            File(path).inputStream().use { it.copyTo(out) }
        }
        val done = ContentValues().apply { put(MediaStore.MediaColumns.IS_PENDING, 0) }
        contentResolver.update(uri, done, null, null)
        return uri.toString()
    }
}
