import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.LinearGradient
import android.graphics.Paint
import android.graphics.Path
import android.graphics.RadialGradient
import android.graphics.RectF
import android.graphics.Shader
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.service.wallpaper.WallpaperService
import android.view.SurfaceHolder
import org.json.JSONObject
import java.util.Calendar
import java.util.Random
import java.util.TimeZone
import kotlin.math.PI
import kotlin.math.sin

/**
 * خلفية حية خفيفة: ترسم على Canvas بمعدل 30 إطارًا وتتوقف تمامًا عند إخفائها.
 * الثيمات: sky (سماء تتبع أوقات الصلاة الفعلية)، grass (عشب ورياح)، night (ليل ونجوم).
 * تقرأ الثيم وأوقات الصلاة من SharedPreferences الخاصة بالتطبيق مرة كل دقيقة.
 */
class AneesLiveWallpaperService : WallpaperService() {
    override fun onCreateEngine(): Engine = SkyEngine()

    private class Key(val t: Long, val top: Int, val bottom: Int)

    inner class SkyEngine : Engine() {
        private val handler = Handler(Looper.getMainLooper())
        private val prefs = applicationContext.getSharedPreferences("FlutterSharedPreferences", Context.MODE_PRIVATE)
        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
        private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeCap = Paint.Cap.ROUND }
        private val path = Path()
        private val path2 = Path()
        private val rect = RectF()
        private var visible = false
        private var w = 0
        private var h = 0
        private var xOff = 0.5f
        private var theme = "sky"
        private var times: LongArray? = null
        private var tzId: String? = null
        private var lastRead = 0L
        private var keys: List<Key> = emptyList()
        private var sunriseMs = 0L
        private var sunsetMs = 0L
        private var fajrMs = 0L
        private var maghribMs = 0L
        private val t0 = System.currentTimeMillis()
        private val day = 86_400_000L

        private val nStars = 110
        private val sx = FloatArray(nStars)
        private val sy = FloatArray(nStars)
        private val sr = FloatArray(nStars)
        private val sp = FloatArray(nStars)
        private val nBlades = 70
        private val bx = FloatArray(nBlades)
        private val bh = FloatArray(nBlades)
        private val bp = FloatArray(nBlades)
        private val nClouds = 5
        private val cx = FloatArray(nClouds)
        private val cy = FloatArray(nClouds)
        private val cw = FloatArray(nClouds)
        private val cs = FloatArray(nClouds)
        private val shades = intArrayOf(0xFF4F9D2D.toInt(), 0xFF5CAA30.toInt(), 0xFF3F8A22.toInt(), 0xFF6BB83A.toInt())

        init {
            val r = Random(11)
            for (i in 0 until nStars) { sx[i] = r.nextFloat(); sy[i] = r.nextFloat(); sr[i] = 0.7f + r.nextFloat() * 1.8f; sp[i] = r.nextFloat() * 6.28f }
            for (i in 0 until nBlades) { bx[i] = r.nextFloat(); bh[i] = 0.12f + r.nextFloat() * 0.18f; bp[i] = r.nextFloat() * 6.28f }
            for (i in 0 until nClouds) { cx[i] = r.nextFloat(); cy[i] = 0.12f + r.nextFloat() * 0.3f; cw[i] = 0.18f + r.nextFloat() * 0.18f; cs[i] = 0.004f + r.nextFloat() * 0.006f }
        }

        private val frame = object : Runnable {
            override fun run() {
                draw()
                if (visible) handler.postDelayed(this, 33)
            }
        }

        override fun onVisibilityChanged(visible: Boolean) {
            this.visible = visible
            handler.removeCallbacks(frame)
            if (visible) {
                lastRead = 0L
                handler.post(frame)
            }
        }

        override fun onSurfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
            super.onSurfaceChanged(holder, format, width, height)
            w = width
            h = height
            draw()
        }

        override fun onSurfaceDestroyed(holder: SurfaceHolder) {
            super.onSurfaceDestroyed(holder)
            visible = false
            handler.removeCallbacks(frame)
        }

        override fun onDestroy() {
            super.onDestroy()
            handler.removeCallbacks(frame)
        }

        override fun onOffsetsChanged(xOffset: Float, yOffset: Float, xStep: Float, yStep: Float, xPixels: Int, yPixels: Int) {
            xOff = xOffset
        }

        private fun draw() {
            if (w == 0 || h == 0) return
            val holder = surfaceHolder
            var c: Canvas? = null
            try {
                c = if (Build.VERSION.SDK_INT >= 26) holder.lockHardwareCanvas() else holder.lockCanvas()
                if (c != null) {
                    val now = System.currentTimeMillis()
                    if (now - lastRead > 60_000L) readPrefs(now)
                    val t = (now - t0) / 1000f
                    when (theme) {
                        "grass" -> drawGrass(c, t)
                        "night" -> drawNight(c, t)
                        else -> drawSky(c, now, t)
                    }
                }
            } catch (e: Exception) {
                // تجاهل: السطح قد يُدمَّر أثناء الرسم
            } finally {
                if (c != null) {
                    try { holder.unlockCanvasAndPost(c) } catch (e: Exception) { }
                }
            }
        }

        private fun readPrefs(now: Long) {
            lastRead = now
            theme = prefs.getString("flutter.live_theme", "sky") ?: "sky"
            tzId = prefs.getString("flutter.tz", null)
            val raw = prefs.getString("flutter.pt_cache", null)
            times = try {
                if (raw == null) null else {
                    val t = JSONObject(raw).getJSONObject("t")
                    longArrayOf(t.getLong("fajr"), t.getLong("sunrise"), t.getLong("dhuhr"), t.getLong("asr"), t.getLong("maghrib"), t.getLong("isha"))
                }
            } catch (e: Exception) { null }
            buildKeys(now)
        }

        private fun todMs(cal: Calendar, ms: Long): Long {
            cal.timeInMillis = ms
            return ((cal.get(Calendar.HOUR_OF_DAY) * 60L + cal.get(Calendar.MINUTE)) * 60L + cal.get(Calendar.SECOND)) * 1000L
        }

        /** يحوّل أوقات الصلاة المحفوظة (ليوم ما) إلى اليوم الحالي، وبذلك تبقى الخلفية صحيحة حتى لو لم يُفتح التطبيق. */
        private fun buildKeys(now: Long) {
            val cal = Calendar.getInstance(tzId?.let { TimeZone.getTimeZone(it) } ?: TimeZone.getDefault())
            cal.timeInMillis = now
            cal.set(Calendar.HOUR_OF_DAY, 0); cal.set(Calendar.MINUTE, 0); cal.set(Calendar.SECOND, 0); cal.set(Calendar.MILLISECOND, 0)
            val dayStart = cal.timeInMillis
            val tod: List<Long> = times?.map { todMs(cal, it) }
                ?: listOf(5.0, 6.2, 12.0, 15.5, 18.0, 19.3).map { (it * 3_600_000).toLong() }
            val m = 60_000L
            fajrMs = dayStart + tod[0]
            sunriseMs = dayStart + tod[1]
            val dhuhr = dayStart + tod[2]
            val asr = dayStart + tod[3]
            maghribMs = dayStart + tod[4]
            sunsetMs = maghribMs
            val isha = dayStart + tod[5]
            keys = listOf(
                Key(fajrMs - 90 * m, 0xFF050816.toInt(), 0xFF0E1633.toInt()),
                Key(fajrMs, 0xFF0B1030.toInt(), 0xFF3A3A6E.toInt()),
                Key(sunriseMs, 0xFF3F6FB5.toInt(), 0xFFFFB36B.toInt()),
                Key(dhuhr, 0xFF2F80D8.toInt(), 0xFFA8D8F0.toInt()),
                Key(asr, 0xFF3C86D0.toInt(), 0xFFCBE3F0.toInt()),
                Key(maghribMs, 0xFF3B3F7A.toInt(), 0xFFFF7A45.toInt()),
                Key(isha, 0xFF0B1030.toInt(), 0xFF1F2A5A.toInt()),
                Key(isha + 120 * m, 0xFF050816.toInt(), 0xFF0E1633.toInt())
            )
        }

        private fun lerp(a: Int, b: Int, f: Float): Int = Color.argb(
            255,
            (Color.red(a) + (Color.red(b) - Color.red(a)) * f).toInt(),
            (Color.green(a) + (Color.green(b) - Color.green(a)) * f).toInt(),
            (Color.blue(a) + (Color.blue(b) - Color.blue(a)) * f).toInt()
        )

        private fun skyColors(now: Long): Pair<Int, Int> {
            val ks = keys
            if (ks.isEmpty()) return Pair(Color.BLACK, Color.BLACK)
            if (now <= ks.first().t || now >= ks.last().t) return Pair(ks.first().top, ks.first().bottom)
            for (i in 0 until ks.size - 1) {
                val a = ks[i]
                val b = ks[i + 1]
                if (now < b.t) {
                    val f = (now - a.t).toFloat() / (b.t - a.t)
                    return Pair(lerp(a.top, b.top, f), lerp(a.bottom, b.bottom, f))
                }
            }
            return Pair(ks.last().top, ks.last().bottom)
        }

        private fun fillGradient(c: Canvas, top: Int, bottom: Int) {
            paint.shader = LinearGradient(0f, 0f, 0f, h.toFloat(), top, bottom, Shader.TileMode.CLAMP)
            c.drawRect(0f, 0f, w.toFloat(), h.toFloat(), paint)
            paint.shader = null
        }

        private fun glow(c: Canvas, x: Float, y: Float, r: Float, color: Int, alpha: Int) {
            val base = color and 0x00FFFFFF
            paint.shader = RadialGradient(x, y, r, intArrayOf((alpha shl 24) or base, base), null, Shader.TileMode.CLAMP)
            c.drawCircle(x, y, r, paint)
            paint.shader = null
        }

        private fun drawStars(c: Canvas, t: Float, night: Float) {
            val d = w / 1080f
            val px = (xOff - 0.5f) * w * 0.04f
            for (i in 0 until nStars) {
                val a = (night * (0.5f + 0.5f * sin(t * (0.8f + (i % 5) * 0.35f) + sp[i])) * 255).toInt()
                paint.color = Color.argb(a.coerceIn(0, 255), 255, 255, 255)
                c.drawCircle(sx[i] * w + px, sy[i] * h * 0.75f, sr[i] * d, paint)
            }
        }

        private fun drawCrescent(c: Canvas, x: Float, y: Float, r: Float, color: Int, alpha: Int) {
            glow(c, x, y, r * 2.2f, color, (alpha * 0.28f).toInt())
            path.reset(); path.addCircle(x, y, r, Path.Direction.CW)
            path2.reset(); path2.addCircle(x + r * 0.45f, y - r * 0.15f, r * 0.86f, Path.Direction.CW)
            path.op(path2, Path.Op.DIFFERENCE)
            paint.color = (alpha shl 24) or (color and 0x00FFFFFF)
            c.drawPath(path, paint)
        }

        private fun drawClouds(c: Canvas, t: Float, visibility: Float) {
            if (visibility <= 0.05f) return
            val px = (xOff - 0.5f) * w * 0.08f
            paint.color = Color.argb((visibility * 62).toInt(), 255, 255, 255)
            for (i in 0 until nClouds) {
                val x = (((cx[i] + t * cs[i]) % 1.5f) - 0.25f) * w + px
                val y = cy[i] * h
                val cwid = cw[i] * w
                val ch = cwid * 0.28f
                rect.set(x, y, x + cwid, y + ch); c.drawOval(rect, paint)
                rect.set(x + cwid * 0.2f, y - ch * 0.5f, x + cwid * 0.7f, y + ch * 0.7f); c.drawOval(rect, paint)
                rect.set(x + cwid * 0.5f, y - ch * 0.2f, x + cwid * 1.1f, y + ch * 0.8f); c.drawOval(rect, paint)
            }
        }

        private fun drawSky(c: Canvas, now: Long, t: Float) {
            if (keys.isEmpty()) buildKeys(now)
            val (top, bottom) = skyColors(now)
            fillGradient(c, top, bottom)
            val lum = (0.299f * Color.red(top) + 0.587f * Color.green(top) + 0.114f * Color.blue(top)) / 255f
            val night = ((0.30f - lum) / 0.22f).coerceIn(0f, 1f)
            if (night > 0f) drawStars(c, t, night)
            if (now in sunriseMs..sunsetMs) {
                val p = (now - sunriseMs).toFloat() / (sunsetMs - sunriseMs)
                val x = w * (0.88f - 0.76f * p)
                val y = h * 0.40f - sin(PI * p).toFloat() * h * 0.24f
                val r = w * 0.07f
                glow(c, x, y, r * 3.4f, 0xFFFFE9A8.toInt(), 110)
                paint.color = 0xFFFFF1B8.toInt()
                c.drawCircle(x, y, r, paint)
            }
            if (night > 0.25f) {
                val nightLen = (fajrMs + day - maghribMs).toFloat()
                val since = if (now >= maghribMs) now - maghribMs else now + day - maghribMs
                val q = (since / nightLen).coerceIn(0f, 1f)
                drawCrescent(c, w * (0.85f - 0.7f * q), h * 0.34f - sin(PI * q).toFloat() * h * 0.2f, w * 0.06f, 0xFFFFF4D6.toInt(), (night * 255).toInt())
            }
            drawClouds(c, t, 1f - night * 0.85f)
        }

        private fun drawNight(c: Canvas, t: Float) {
            fillGradient(c, 0xFF050816.toInt(), 0xFF0E1633.toInt())
            drawStars(c, t, 1f)
            drawCrescent(c, w * 0.75f, h * 0.2f, w * 0.1f, 0xFFFFE9A8.toInt(), 255)
            val ph = t % 14f
            if (ph < 1.2f) {
                val pr = ph / 1.2f
                val x = w * 0.9f - pr * w * 0.5f
                val y = h * 0.12f + pr * h * 0.18f
                stroke.strokeWidth = 3f * (w / 1080f)
                stroke.color = Color.argb(((1f - pr) * 255).toInt(), 255, 255, 255)
                c.drawLine(x, y, x + w * 0.1f, y - h * 0.035f, stroke)
            }
        }

        private fun drawGrass(c: Canvas, t: Float) {
            paint.shader = LinearGradient(
                0f, 0f, 0f, h.toFloat(),
                intArrayOf(0xFFCDEFA9.toInt(), 0xFF7FC24A.toInt(), 0xFF2F7A1E.toInt()),
                floatArrayOf(0f, 0.55f, 1f), Shader.TileMode.CLAMP
            )
            c.drawRect(0f, 0f, w.toFloat(), h.toFloat(), paint)
            paint.shader = null
            glow(c, w * 0.82f, h * 0.14f, w * 0.5f, 0xFFFFF6C8.toInt(), 150)
            val d = w / 1080f
            val par = (xOff - 0.5f) * w * 0.02f
            for (i in 0 until nBlades) {
                val x = bx[i] * w
                val ht = bh[i] * h
                val sway = sin(t * 1.1f + bp[i]) * ht * 0.12f + par
                path.reset()
                path.moveTo(x - 7 * d, h.toFloat())
                path.quadTo(x + sway * 0.4f, h - ht * 0.55f, x + sway, h - ht)
                path.quadTo(x + sway * 0.4f + 4 * d, h - ht * 0.5f, x + 7 * d, h.toFloat())
                path.close()
                paint.color = shades[i % shades.size]
                c.drawPath(path, paint)
            }
        }
    }
}
