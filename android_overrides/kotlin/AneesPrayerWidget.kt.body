import android.app.AlarmManager
import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.appwidget.AppWidgetProvider
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.os.SystemClock
import android.view.View
import android.widget.RemoteViews
import org.json.JSONObject
import java.util.Calendar
import java.util.TimeZone

/**
 * ويدجت الصلاة القادمة. العدّ التنازلي يرسمه النظام بنفسه (Chronometer)
 * فلا يستيقظ التطبيق كل ثانية. يُحدَّث عند موعد كل صلاة وعند تغيّر الأوقات.
 */
class AneesPrayerWidget : AppWidgetProvider() {
    override fun onUpdate(context: Context, manager: AppWidgetManager, ids: IntArray) {
        for (id in ids) render(context, manager, id)
        scheduleTick(context)
    }

    override fun onReceive(context: Context, intent: Intent) {
        super.onReceive(context, intent)
        if (intent.action == ACTION_TICK) updateAll(context)
    }

    override fun onDisabled(context: Context) {
        super.onDisabled(context)
        (context.getSystemService(Context.ALARM_SERVICE) as AlarmManager).cancel(tickIntent(context))
    }

    companion object {
        const val ACTION_TICK = "anees.widget.TICK"
        private const val DAY = 86_400_000L

        private class Next(val name: String, val ms: Long)

        private fun prefs(context: Context) =
            context.getSharedPreferences("FlutterSharedPreferences", Context.MODE_PRIVATE)

        /** أقرب صلاة قادمة من الأوقات المحفوظة (تُزاح يوميًا فتبقى صحيحة حتى لو لم يُفتح التطبيق). */
        private fun next(context: Context): Next? {
            val raw = prefs(context).getString("flutter.pt_cache", null) ?: return null
            return try {
                val t = JSONObject(raw).getJSONObject("t")
                val now = System.currentTimeMillis()
                var best: Next? = null
                val names = listOf("fajr" to "الفجر", "dhuhr" to "الظهر", "asr" to "العصر", "maghrib" to "المغرب", "isha" to "العشاء")
                for ((key, name) in names) {
                    val ms = t.getLong(key)
                    val cand = ms + (Math.floorDiv(now - ms, DAY) + 1) * DAY
                    if (best == null || cand < best.ms) best = Next(name, cand)
                }
                best
            } catch (e: Exception) {
                null
            }
        }

        private fun arabicDigits(s: String): String =
            s.map { if (it in '0'..'9') '٠' + (it - '0') else it }.joinToString("")

        private fun fmt(ms: Long, tzId: String?): String {
            val cal = Calendar.getInstance(tzId?.let { TimeZone.getTimeZone(it) } ?: TimeZone.getDefault())
            cal.timeInMillis = ms
            val h24 = cal.get(Calendar.HOUR_OF_DAY)
            val h = if (h24 % 12 == 0) 12 else h24 % 12
            val m = cal.get(Calendar.MINUTE).toString().padStart(2, '0')
            return arabicDigits("$h:$m ${if (h24 < 12) "ص" else "م"}")
        }

        private fun tickIntent(context: Context): PendingIntent {
            val i = Intent(context, AneesPrayerWidget::class.java).setAction(ACTION_TICK)
            return PendingIntent.getBroadcast(context, 1, i, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
        }

        fun scheduleTick(context: Context) {
            val n = next(context) ?: return
            val am = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
            am.setAndAllowWhileIdle(AlarmManager.RTC, n.ms + 2000, tickIntent(context))
        }

        private fun render(context: Context, manager: AppWidgetManager, id: Int) {
            val views = RemoteViews(context.packageName, R.layout.anees_widget)
            val n = next(context)
            if (n == null) {
                views.setTextViewText(R.id.w_name, "افتح التطبيق")
                views.setTextViewText(R.id.w_time, "")
                views.setViewVisibility(R.id.w_chrono_row, View.GONE)
            } else {
                views.setTextViewText(R.id.w_name, n.name)
                views.setTextViewText(R.id.w_time, fmt(n.ms, prefs(context).getString("flutter.tz", null)))
                views.setViewVisibility(R.id.w_chrono_row, View.VISIBLE)
                val base = SystemClock.elapsedRealtime() + (n.ms - System.currentTimeMillis())
                views.setChronometerCountDown(R.id.w_chrono, true)
                views.setChronometer(R.id.w_chrono, base, null, true)
            }
            val launch = context.packageManager.getLaunchIntentForPackage(context.packageName)
            if (launch != null) {
                val pi = PendingIntent.getActivity(context, 0, launch, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
                views.setOnClickPendingIntent(R.id.w_root, pi)
            }
            manager.updateAppWidget(id, views)
        }

        fun updateAll(context: Context) {
            val manager = AppWidgetManager.getInstance(context)
            val ids = manager.getAppWidgetIds(ComponentName(context, AneesPrayerWidget::class.java))
            if (ids.isEmpty()) return
            for (id in ids) render(context, manager, id)
            scheduleTick(context)
        }
    }
}
